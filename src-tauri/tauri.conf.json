{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Action & Quality",
  "version": "1.0.0",
  "identifier": "ru.actionquality.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Action & Quality",
        "width": 430,
        "height": 930,
        "minWidth": 380,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#F9D7E8"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
